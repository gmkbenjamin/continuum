{
  "version": 1,
  "_comment": "Continuum detection and delivery rules. Everything an agent update could change lives here, not in code. Override or extend any part in ~/.continuum/rules.json; entries are merged by name.",

  "defaults": {
    "resume_prompt": "Your usage limit has reset. Continue the task you were working on when the limit was reached; do not repeat work that is already complete.",
    "delay_after_reset_seconds": 60,
    "native_grace_seconds": 0,
    "transient_backoff_seconds": [120, 300, 900, 1800, 3600],
    "unknown_reset_backoff_seconds": [900, 1800, 3600, 3600, 7200],
    "max_attempts": 8,
    "enter_delay_ms": 400,
    "tail_lines": 40,
    "common_patterns": [
      {"kind": "usage_limit", "regex": "(?i)(?:usage|rate|quota|request|token)\\s+limit\\s+(?:has\\s+been\\s+|was\\s+)?(?:reached|exceeded|hit)"},
      {"kind": "usage_limit", "regex": "(?i)\\bquota\\s+(?:has\\s+been\\s+)?(?:exceeded|exhausted)"},
      {"kind": "usage_limit", "regex": "(?i)exhausted\\s+(?:your|the)\\s+(?:daily\\s+|monthly\\s+|weekly\\s+)?(?:quota|limit|usage)"},
      {"kind": "usage_limit", "regex": "(?i)\\bRESOURCE_EXHAUSTED\\b"},
      {"kind": "usage_limit", "regex": "(?i)you[’']?ve\\s+(?:hit|reached|used\\s+up)\\s+(?:your|the)\\s+(?:[a-z0-9 -]{0,30}\\s+)?(?:limit|quota|allowance)"},
      {"kind": "usage_limit", "regex": "(?i)you\\s+have\\s+(?:hit|reached|exceeded)\\s+(?:your|the)\\s+(?:[a-z0-9 -]{0,30}\\s+)?(?:limit|quota)"},
      {"kind": "usage_limit", "regex": "(?i)(?:limit|quota|usage)\\s+(?:will\\s+)?resets?\\s+(?:at|in|on)\\b"},
      {"kind": "usage_limit", "regex": "(?i)try\\s+again\\s+(?:at|in|after)\\s+\\d"},
      {"kind": "transient", "regex": "(?i)\\b(?:429|529)\\b.{0,40}(?:too\\s+many\\s+requests|overloaded|rate)"},
      {"kind": "transient", "regex": "(?i)\\b(?:overloaded_error|server\\s+is\\s+overloaded|service\\s+unavailable)\\b"},
      {"kind": "transient", "regex": "(?i)\\b50[0234]\\b\\s+(?:internal\\s+server\\s+error|bad\\s+gateway|service\\s+unavailable|gateway\\s+time-?out)"}
    ],
    "_common_patterns": "Wording most agents use. Harnesses with use_common_patterns add these to their own patterns. Only the bottom of the screen is checked, so an agent merely talking about rate limits higher up is not mistaken for a stall.",
    "common_never_resume_patterns": [
      "(?i)out\\s+of\\s+(?:free\\s+|usage\\s+|account\\s+)?credits?",
      "(?i)insufficient[_ ](?:quota|credits?|balance|funds)",
      "(?i)credit\\s+balance\\s+is\\s+too\\s+low",
      "(?i)(?:spend(?:ing)?|budget)\\s+(?:limit|cap)",
      "(?i)billing",
      "(?i)payment\\s+required",
      "(?i)add\\s+(?:funds|credits|a\\s+payment)",
      "(?i)upgrade\\s+your\\s+plan\\s+to\\s+continue",
      "(?i)(?:invalid|expired|missing)\\s+api[\\s_-]?key",
      "(?i)please\\s+(?:log\\s*in|sign\\s*in|re-?authenticate)",
      "(?i)\\b401\\b.{0,30}unauthori[sz]ed"
    ],
    "interpreters": ["node", "nodejs", "bun", "deno", "python", "pypy", "ruby", "java", "uv", "npx", "bunx"],
    "blocking_patterns": [
      "(?im)^\\s*[❯›>▶➜]\\s*1\\.\\s",
      "(?i)enter\\s+(?:to\\s+)?(?:continue|confirm|select)\\s*·\\s*esc",
      "(?i)do\\s+you\\s+(?:want|trust)",
      "(?i)\\ballow\\s+(?:this|command|codex|claude|edit|the)\\b.{0,60}\\?",
      "(?i)\\b(?:approve|deny)\\b.{0,40}\\?",
      "(?i)press\\s+enter\\s+to",
      "(?i)\\(y/n\\)|\\[y/N\\]|\\[Y/n\\]",
      "(?im)^\\s*[❯›>▶➜]\\s*(?:\\d+[.)]\\s*)?(?:yes|no)\\b[^\\n]{0,60}\\n(?:[^\\n]*\\n)?\\s*(?:\\d+[.)]\\s*)?(?:yes|no)\\b|^\\s*(?:\\d+[.)]\\s*)?(?:yes|no)\\b[^\\n]{0,60}\\n(?:[^\\n]*\\n)?\\s*[❯›>▶➜]\\s*(?:\\d+[.)]\\s*)?(?:yes|no)\\b",
      "(?im)^\\s*[❯›>▶➜]?\\s*(?:yes|no|allow|deny|proceed|cancel|quit)\\b[^\\n]{0,60}\\s[\\[(]?[yn][\\])]?\\s*$",
      "(?i)\\b(?:trust|allow)\\s+(?:this|the)\\s+(?:folder|directory|workspace|project)\\b"
    ],
    "_blocking_patterns": "If any of these shows in the bottom of the pane, a menu or approval prompt is open. Continuum never types into it (Enter could pick an option); it uses another route or tries again later."
  },

  "harnesses": {
    "claude": {
      "display_name": "Claude Code",
      "homepage": "https://claude.com/product/claude-code",
      "binary": "claude",
      "process_names": ["claude", "Claude"],
      "process_name_patterns": ["^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.]+)?$"],
      "_process_name_patterns": "The native installer runs Claude Code from a binary named after its version (e.g. 2.1.322), which is what tmux reports.",
      "native_grace_seconds": 300,
      "_native_grace": "Claude Code tries to resume by itself after a reset while its process is alive. Continuum gives it this long past the reset first, so the two don't both continue the session, then acts only if the session shows no new activity. Change it with `continuum grace claude <minutes|off>`.",
      "ignore_entrypoints": ["^sdk", "^mcp$"],
      "session_env": ["CLAUDE_CODE_SESSION_ID"],
      "_ignore_entrypoints": "Print mode (claude -p) and Agent SDK scripts report these entrypoints. Nobody types into them, and continuing one would start work nobody asked for, so Continuum leaves them alone.",
      "desktop_apps": [
        {"name": "Claude Desktop", "entrypoints": ["claude-desktop", "desktop"],
         "process_patterns": ["(?i)/Claude\\.app/Contents/MacOS/Claude(?:\\s|$)", "(?i)\\\\Claude\\\\Claude\\.exe", "(?i)\\\\AnthropicClaude\\\\", "(?i)(?:^|/)claude-desktop(?:\\s|$)", "(?i)^claude\\.exe$"],
         "_process_patterns": "Windows lists programs by name only, and the Claude app and Claude Code's CLI are both claude.exe: while either runs, a session the app may hold counts as open there.",
         "version_dir": "{app_support}/Claude/claude-code", "guard_unknown": true}
      ],
      "_desktop_apps": "Claude Desktop runs Claude Code sessions without a terminal. While the app runs, a session it may hold is treated as open (Continuum never starts a copy of it) unless Claude's own session list, already seen to include Desktop sessions for this app version, says it is closed.",
      "live_sessions": {
        "command": ["{bin}", "agents", "--json"],
        "requires_help": ["agents"],
        "registry_dir": "{claude_home}/sessions",
        "busy_states": ["busy", "working", "running", "active", "streaming"],
        "background_kinds": ["background", "bg"]
      },
      "wrap": {
        "passthrough_flags": ["-p", "--print", "-v", "--version", "-h", "--help", "--bg", "--background", "--cloud", "--desktop", "--teleport"],
        "passthrough_subcommands": ["agents", "attach", "auth", "auto-mode", "config", "doctor", "gateway", "import", "install", "logs", "mcp", "migrate-installer", "plugin", "plugins", "purge", "respawn", "rm", "setup-token", "stop", "kill", "ultrareview", "update", "upgrade"]
      },
      "stop_failure_kinds": {
        "rate_limit": "usage_limit",
        "overloaded": "transient",
        "server_error": "transient",
        "unknown": "transient"
      },
      "patterns": [
        {"kind": "usage_limit", "regex": "(?i)you[’']?ve\\s+hit\\s+your\\s+(?:[a-z0-9 ]{0,30}\\s+)?limit"},
        {"kind": "usage_limit", "regex": "(?i)(?:claude\\s+)?usage\\s+limit\\s+reached"},
        {"kind": "usage_limit", "regex": "(?i)your\\s+limit\\s+will\\s+reset"},
        {"kind": "usage_limit", "regex": "(?i)you[’']?re\\s+out\\s+of\\s+(?:extra\\s+)?usage"},
        {"kind": "transient", "regex": "(?i)API\\s+Error:\\s*(?:529|500|502|503|504)\\b"},
        {"kind": "transient", "regex": "(?i)\\boverloaded_error\\b"},
        {"kind": "transient", "regex": "(?i)API\\s+Error:\\s*429\\b"}
      ],
      "native_wait_patterns": ["(?i)continuing\\s+automatically"],
      "native_gave_up_patterns": ["(?i)will\\s+not\\s+resume\\s+on\\s+its\\s+own", "(?i)did\\s+not\\s+resume\\s+on\\s+its\\s+own", "(?i)continue\\s+cancelled"],
      "limit_reset_patterns": ["(?i)\\breset\\s+used\\b"],
      "_limit_reset_patterns": "Claude Code's /limit-reset prints this when a banked reset is used. Only the command's own output counts, never a prompt or a reply.",
      "never_resume_patterns": ["(?i)credit\\s+balance\\s+is\\s+too\\s+low", "(?i)out\\s+of\\s+usage\\s+credits", "(?i)spend\\s+limit", "(?i)add\\s+funds", "(?i)authentication_failed", "(?i)billing_error", "(?i)please\\s+run\\s+/login"],
      "ui_markers": ["(?i)esc to (?:cancel|interrupt)", "(?i)\\? for shortcuts", "(?i)/rate-limit-options", "╭", "❯"],
      "native_commands": [
        {"name": "claude-attach", "when": "background", "pty": true, "requires_help": ["attach"], "args": ["{bin}", "attach", "{short_id}"], "cwd": "{cwd}"},
        {"name": "claude-bg-resume", "when": "stopped", "requires_help": ["--bg", "--resume"], "args": ["{bin}", "--bg", "--resume", "{session}", "{prompt}"], "cwd": "{cwd}"},
        {"name": "claude-print-resume", "when": "stopped", "requires_help": ["--resume", "--print"], "args": ["{bin}", "--print", "--resume", "{session}", "{prompt}"], "cwd": "{cwd}", "detach": true}
      ],
      "_native_commands": "Used in order. claude-attach types into a Claude background session through `claude attach` in a hidden terminal; the session keeps running when that terminal closes. The other two continue a session under its own id, and are only used once the session is no longer open anywhere, so they never start a copy."
    },

    "codex": {
      "display_name": "Codex",
      "homepage": "https://github.com/openai/codex",
      "binary": "codex",
      "process_names": ["codex", "Codex"],
      "native_grace_seconds": 30,
      "desktop_apps": [
        {"name": "Codex Desktop", "entrypoints": ["Codex Desktop", "codex-desktop", "desktop"],
         "process_patterns": ["(?i)/Codex\\.app/Contents/MacOS/", "(?i)/ChatGPT\\.app/Contents/MacOS/ChatGPT(?:\\s|$)", "(?i)\\\\Codex\\.exe", "(?i)^codex\\.exe$", "(?i)^chatgpt\\.exe$"],
         "guard_unknown": false}
      ],
      "_desktop_apps": "The Codex app runs threads on the local Codex app server. codex queue delivers to that same server, so it reaches a thread the app has open (reaches_desktop).",
      "live_sessions": {
        "scan_processes": true,
        "process_exclude_args": ["app-server", "exec", "queue", "mcp", "mcp-server", "login", "logout", "completion", "apply", "sandbox", "debug", "cloud", "features", "--version", "--help", "codex-code-mode-host"]
      },
      "wrap": {
        "passthrough_flags": ["-V", "--version", "-h", "--help"],
        "passthrough_subcommands": ["exec", "e", "login", "logout", "mcp", "mcp-server", "app-server", "app", "completion", "apply", "a", "sandbox", "debug", "queue", "cloud", "features", "help", "generate-ts", "proto", "archive", "delete", "doctor", "exec-server", "migrate-nfs-db", "migrate-rollouts", "plugin", "remote-control", "unarchive", "update"],
        "value_flags": ["-a", "-c", "-C", "-i", "-m", "-p", "-s", "--add-dir", "--ask-for-approval", "--cd", "--config", "--disable", "--enable", "--image", "--local-provider", "--model", "--profile", "--remote", "--remote-auth-token-env", "--sandbox"]
      },
      "patterns": [
        {"kind": "usage_limit", "regex": "(?i)you[’']?ve\\s+hit\\s+your\\s+usage\\s+limit"},
        {"kind": "usage_limit", "regex": "(?i)usage_limit_(?:exceeded|reached)"},
        {"kind": "usage_limit", "regex": "(?i)usage\\s+limit\\s+reached"},
        {"kind": "transient", "regex": "(?i)stream\\s+disconnected\\s+before\\s+completion"},
        {"kind": "transient", "regex": "(?i)exceeded\\s+retry\\s+limit"},
        {"kind": "transient", "regex": "(?i)\\b(?:500|502|503|529)\\s+(?:Internal Server Error|Bad Gateway|Service Unavailable)"}
      ],
      "native_wait_patterns": [],
      "native_gave_up_patterns": [],
      "never_resume_patterns": ["(?i)credit\\s+balance\\s+is\\s+too\\s+low", "(?i)out\\s+of\\s+credits", "(?i)spend\\s+cap", "(?i)request\\s+a\\s+limit\\s+increase", "(?i)send\\s+a\\s+request\\s+to\\s+your\\s+admin"],
      "ui_markers": ["(?i)esc to interrupt", "(?i)context left", "›", "▌"],
      "native_commands": [
        {"name": "codex-queue", "when": "stopped", "reaches_desktop": true, "queued_warning": "Warning: message was queued, but could not resume thread", "requires_help": ["queue"], "requires_subcommand_help": {"queue": ["--thread", "--message", "--resume"]}, "args": ["{bin}", "queue", "--thread", "{session}", "--message", "{prompt}", "--resume"], "cwd": "{cwd}"},
        {"name": "codex-exec-resume", "when": "stopped", "requires_help": ["exec"], "requires_subcommand_help": {"exec": ["resume", "--json"]}, "args": ["{bin}", "exec", "--json", "resume", "{session}", "{prompt}"], "cwd": "{cwd}", "detach": true}
      ]
    },

    "gemini": {
      "display_name": "Gemini CLI",
      "homepage": "https://github.com/google-gemini/gemini-cli",
      "binary": "gemini",
      "process_names": ["gemini"],
      "process_arg_patterns": ["@google/gemini-cli", "[/\\\\]gemini-cli[/\\\\]", "(?:^|[/\\\\])gemini(?:\\.js)?(?:\\s|$)"],
      "use_common_patterns": true,
      "patterns": [{"kind": "usage_limit", "regex": "(?i)quota\\s+exceeded\\s+for\\s+quota\\s+metric"}, {"kind": "usage_limit", "regex": "(?i)reached\\s+your\\s+daily\\s+(?:\\S+\\s+)?(?:request\\s+)?(?:limit|quota)"}, {"kind": "usage_limit", "regex": "(?i)usage\\s+limit\\s+reached\\s+for"}],
      "never_resume_patterns": [],
      "ui_markers": ["(?i)type\\s+your\\s+message", "(?i)esc\\s+to\\s+cancel", "(?i)context\\s+left", "(?i)gemini-\\d"],
      "wrap": {"passthrough_flags": ["-V", "-h", "-p", "-v", "--help", "--prompt", "--version", "--list-sessions", "--delete-session"], "passthrough_subcommands": ["mcp", "extensions", "hooks"]},
      "live_sessions": {"scan_processes": true, "process_exclude_args": ["mcp", "extensions"]},
      "native_commands": []
    },

    "qwen": {
      "display_name": "Qwen Code",
      "homepage": "https://github.com/QwenLM/qwen-code",
      "binary": "qwen",
      "process_names": ["qwen"],
      "process_arg_patterns": ["@qwen-code/qwen-code", "[/\\\\]qwen-code[/\\\\]"],
      "use_common_patterns": true,
      "patterns": [{"kind": "usage_limit", "regex": "(?i)free\\s+(?:tier|quota).{0,60}(?:reached|exceeded|exhausted|limit)"}],
      "never_resume_patterns": [],
      "ui_markers": ["(?i)type\\s+your\\s+message", "(?i)esc\\s+to\\s+cancel", "(?i)context\\s+left"],
      "wrap": {"passthrough_flags": ["-V", "-h", "-p", "-v", "--help", "--prompt", "--version"], "passthrough_subcommands": ["mcp", "extensions"]},
      "live_sessions": {"scan_processes": true, "process_exclude_args": ["mcp", "extensions"]},
      "native_commands": []
    },

    "aider": {
      "display_name": "Aider",
      "homepage": "https://aider.chat",
      "binary": "aider",
      "process_names": ["aider"],
      "process_arg_patterns": ["(?:^|[/\\\\])aider(?:\\s|$)", "aider_chat", "aider-chat"],
      "use_common_patterns": true,
      "patterns": [{"kind": "transient", "regex": "(?i)litellm\\.(?:RateLimitError|ServiceUnavailableError|InternalServerError|APIConnectionError)"}],
      "never_resume_patterns": ["(?i)AuthenticationError"],
      "ui_markers": ["(?im)^(?:architect|ask|code|diff|multi|context|help)?>\\s*$", "(?i)tokens:\\s+\\S+\\s+sent"],
      "wrap": {"passthrough_flags": ["-V", "-f", "-h", "-m", "-v", "--exit", "--help", "--lint", "--test", "--apply", "--commit", "--models", "--message", "--version", "--list-models", "--message-file", "--show-prompts", "--show-repo-map", "--browser", "--gui", "--msg"]},
      "live_sessions": {"scan_processes": true, "process_exclude_args": []},
      "native_commands": []
    },

    "opencode": {
      "display_name": "opencode",
      "homepage": "https://opencode.ai",
      "binary": "opencode",
      "process_names": ["opencode"],
      "process_arg_patterns": ["(?:^|[/\\\\])opencode(?:\\s|$)", "opencode-ai"],
      "_screen_detection": "opencode 2 draws by moving the cursor and redraws its title after an error: the message is only whole on the rendered screen.",
      "screen_detection": true,
      "use_common_patterns": true,
      "patterns": [],
      "never_resume_patterns": [],
      "ui_markers": ["(?i)ctrl\\+p\\s+commands", "(?i)esc\\s+interrupt", "(?i)\\btab\\s+(?:agents?|switch)", "(?i)opencode\\s+v?\\d"],
      "wrap": {"passthrough_flags": ["-V", "-h", "-v", "--help", "--version", "--completions"], "passthrough_subcommands": ["upgrade", "update", "uninstall", "acp", "api", "debug", "auth", "mcp", "plugin", "models", "stats", "run", "session", "service", "reload", "pair", "serve"]},
      "live_sessions": {"scan_processes": true, "process_exclude_args": ["serve", "service", "acp", "api", "run", "mcp", "debug", "models"]},
      "native_commands": []
    },

    "grok": {
      "stop_hook_answers": true,
      "display_name": "Grok Build",
      "homepage": "https://x.ai",
      "binary": "grok",
      "process_names": ["grok"],
      "_hook_env": "Grok Build runs Claude Code's hooks (~/.claude/settings.json) and sets these variables for every hook, so those runs are reported as Grok's.",
      "hook_env": ["GROK_SESSION_ID", "GROK_HOOK_EVENT"],
      "session_env": ["GROK_SESSION_ID"],
      "stop_failure_kinds": {
        "rate_limit": "usage_limit",
        "server_error": "transient",
        "unknown": "transient"
      },
      "use_common_patterns": true,
      "patterns": [
        {"kind": "usage_limit", "regex": "(?i)you[’']?ve\\s+reached\\s+your\\s+free\\s+grok\\s+build\\s+usage\\s+limit"},
        {"kind": "usage_limit", "regex": "(?i)you[’']?ve\\s+hit\\s+the\\s+rate\\s+limit\\s+for\\s+your\\s+plan"},
        {"kind": "usage_limit", "regex": "(?i)you[’']?ve\\s+hit\\s+your\\s+team[’']?s\\s+api\\s+rate\\s+limit"},
        {"kind": "transient", "regex": "(?i)grok\\s+is\\s+temporarily\\s+overloaded"},
        {"kind": "transient", "regex": "(?i)something\\s+went\\s+wrong\\s+on\\s+(?:the\\s+server|our\\s+side)"},
        {"kind": "transient", "regex": "(?i)connection\\s+to\\s+grok\\s+timed\\s+out"}
      ],
      "never_resume_patterns": ["(?i)sign-in\\s+was\\s+rejected", "(?i)run\\s+`?grok\\s+login`?", "(?i)deployment\\s+key\\s+was\\s+rejected"],
      "ui_markers": ["(?i)esc\\s+to\\s+(?:interrupt|cancel)", "(?i)shift\\+tab", "(?i)grok\\s+build"],
      "wrap": {"passthrough_flags": ["-V", "-h", "-p", "-v", "--help", "--single", "--version", "--prompt-file", "--prompt-json", "--output-format"], "passthrough_subcommands": ["agent", "clone", "completions", "doctor", "du", "disk-usage", "export", "help", "inspect", "leader", "login", "logout", "mcp", "memory", "models", "plugin", "sessions", "setup", "trace", "update", "usage", "version", "v", "worker", "worktree", "wrap"]},
      "_live_sessions": "Grok Build lists its open sessions (session_id, pid, cwd) in active_sessions.json.",
      "live_sessions": {"registry_file": "{grok_home}/active_sessions.json", "scan_processes": true, "process_exclude_args": ["agent", "leader", "worker", "mcp", "doctor", "sessions", "usage", "update", "host-server"]},
      "native_commands": [
        {"name": "grok-headless-resume", "when": "stopped", "requires_help": ["--resume", "--single"], "args": ["{bin}", "--resume", "{session}", "--single", "{prompt}"], "cwd": "{cwd}", "detach": true}
      ]
    },

    "muse": {
      "stop_hook_answers": true,
      "display_name": "Muse Code",
      "binary": "muse",
      "_process_names": "`muse` is a launcher script that runs muse-bin-<version>; the prefix match covers both.",
      "process_names": ["muse"],
      "process_arg_patterns": ["[/\\\\]muse-bin-\\d"],
      "session_env": ["MUSE_SESSION_ID"],
      "_hook_requires_cli": "The Muse desktop app may share the settings file.",
      "hook_requires_cli": true,
      "_stop_failure_kinds": "Muse Code's hooks follow Claude Code's (SessionStart, StopFailure, Stop, SessionEnd, with error, error_details and last_assistant_message).",
      "stop_failure_kinds": {
        "rate_limit": "usage_limit",
        "rate_limited": "usage_limit",
        "tier_limit": "usage_limit",
        "quota_exhausted": "usage_limit",
        "overloaded": "transient",
        "server_error": "transient",
        "unknown": "transient"
      },
      "use_common_patterns": true,
      "patterns": [
        {"kind": "usage_limit", "regex": "(?i)usage\\s+exhausted"},
        {"kind": "usage_limit", "regex": "(?i)(?:tier\\s+)?quota\\s+(?:is\\s+)?exhausted"}
      ],
      "never_resume_patterns": ["(?i)run\\s+`?muse\\s+login`?", "(?i)not\\s+logged\\s+in", "(?i)couldn[’']?t\\s+(?:read|access)\\s+your\\s+(?:saved\\s+login|meta\\s+credentials)", "(?i)keychain\\s+is\\s+locked"],
      "ui_markers": ["(?i)muse\\s+code", "(?i)voice\\s+input\\s+\\(", "(?i)ctrl\\+o\\s+to\\s+expand", "(?i)esc\\s+to\\s+(?:interrupt|cancel)", "❯"],
      "wrap": {"passthrough_flags": ["-V", "-h", "--help", "--version"], "passthrough_subcommands": ["exec", "config", "export", "trace", "model-profile", "skills", "voice", "plugins", "sandbox", "schema", "serve", "mxp", "acp", "session-message", "sessions", "mcp", "auth", "login", "logout", "usage", "init", "help"]},
      "_live_sessions": "`muse sessions --json` lists the sessions running on this machine ({\"sessions\": [{sessionId, name, openedBy, ...}]}). The `muse` launcher checks for an update (a large download) at most hourly when it runs: Continuum's checks ask it not to.",
      "live_sessions": {"command": ["env", "MUSE_NO_AUTO_UPDATE=1", "{bin}", "sessions", "--json"]},
      "native_commands": []
    },

    "amp": {
      "display_name": "Amp",
      "homepage": "https://ampcode.com",
      "binary": "amp",
      "shell_hook": false,
      "process_names": ["amp"],
      "process_arg_patterns": ["@sourcegraph/amp", "[/\\\\]amp-cli[/\\\\]"],
      "use_common_patterns": true,
      "patterns": [],
