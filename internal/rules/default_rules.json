  "terminal_apps": {
    "ghostty": {
      "name": "Ghostty",
      "_why": "Ghostty (1.4+) has a scripting interface: find the terminal whose tty is the agent's, then input text and press Enter, without focusing it. It can't hand over its screen, so Continuum only types there when the agent itself reports that no menu or prompt is open.",
      "process_patterns": ["(?i)/Ghostty\\.app/Contents/MacOS/ghostty(?:\\s|$)"],
      "find": ["osascript", "-e", "on run argv", "-e", "set out to \"\"", "-e", "tell application \"Ghostty\"", "-e", "repeat with t in terminals", "-e", "if (tty of t) is (item 1 of argv) then set out to out & (id of t) & tab & (pid of t) & linefeed", "-e", "end repeat", "-e", "end tell", "-e", "return out", "-e", "end run", "{tty}"],
      "send_text": ["osascript", "-e", "on run argv", "-e", "tell application \"Ghostty\" to input text (item 2 of argv) to (first terminal whose id is (item 1 of argv))", "-e", "end run", "{id}", "{text}"],
      "send_enter": ["osascript", "-e", "on run argv", "-e", "tell application \"Ghostty\" to send key \"enter\" to (first terminal whose id is (item 1 of argv))", "-e", "end run", "{id}"],
      "capture": []
    }
  },

  "multiplexers": {
    "_order": "Checked in this order when an agent's environment names more than one. Inner multiplexers come first.",
    "tmux": {
      "priority": 10,
      "env_target": "TMUX_PANE",
      "env_socket": "TMUX",
      "socket_transform": "first_csv_field",
      "send_text": ["tmux", ["-S", "{socket}"], "send-keys", "-t", "{target}", "-l", "--", "{text}"],
      "send_enter": ["tmux", ["-S", "{socket}"], "send-keys", "-t", "{target}", "Enter"],
      "capture": ["tmux", ["-S", "{socket}"], "capture-pane", "-p", "-J", "-t", "{target}", "-S", "-120"],
      "process": ["tmux", ["-S", "{socket}"], "display-message", "-p", "-t", "{target}", "#{pane_current_command}"],
      "list": ["tmux", ["-S", "{socket}"], "list-panes", "-a", "-F", "#{pane_id}\t#{pane_current_command}\t#{socket_path}"],
      "_list": "Pane id, what runs in it, and the server's socket path (the one its panes' TMUX names, so a pane found here matches the one a hook reported)."
    },
    "screen": {
      "priority": 20,
      "env_target": "WINDOW",
      "env_socket": "STY",
      "require_env": ["STY"],
      "send_text": ["screen", "-S", "{socket}", "-p", "{target}", "-X", "stuff", "{text_screen}"],
      "send_enter": ["screen", "-S", "{socket}", "-p", "{target}", "-X", "stuff", "\r"],
      "capture": ["screen", "-S", "{socket}", "-p", "{target}", "-X", "hardcopy", "-h", "{tmpfile}"],
      "capture_from": "tmpfile"
    },
    "zellij": {
      "priority": 30,
      "env_target": "ZELLIJ_PANE_ID",
      "env_socket": "ZELLIJ_SESSION_NAME",
      "target_format": "terminal_%s",
      "send_text": ["zellij", "--session", "{socket}", "action", "write-chars", "--pane-id", "{target}", "{text}"],
      "send_enter": ["zellij", "--session", "{socket}", "action", "write", "--pane-id", "{target}", "13"],
      "capture": ["zellij", "--session", "{socket}", "action", "dump-screen", "--pane-id", "{target}"]
    },
    "herdr": {
      "priority": 40,
      "env_target": "HERDR_PANE_ID",
      "env_socket": "HERDR_SESSION",
      "send_text": ["herdr", ["--session", "{socket}"], "pane", "send-text", "{target}", "{text}"],
      "send_enter": ["herdr", ["--session", "{socket}"], "pane", "send-keys", "{target}", "enter"],
      "capture": ["herdr", ["--session", "{socket}"], "pane", "read", "{target}", "--source", "recent-unwrapped", "--lines", "120"]
    },
    "rex": {
      "priority": 50,
      "env_target": "REX_BLOCK",
      "env_socket": "REX_SERVER",
      "send_text": ["rex", ["-S", "{socket}"], "--autostart=false", "send", "-b", "{target}", "{text}"],
      "send_enter": ["rex", ["-S", "{socket}"], "--autostart=false", "send-key", "-b", "{target}", "enter"],
      "capture": ["rex", ["-S", "{socket}"], "--autostart=false", "capture", "-b", "{target}", "--trim", "--unwrap"]
    },
    "wezterm": {
      "priority": 60,
      "env_target": "WEZTERM_PANE",
      "send_text": ["wezterm", "cli", "send-text", "--pane-id", "{target}", "--no-paste", "{text}"],
      "send_enter": ["wezterm", "cli", "send-text", "--pane-id", "{target}", "--no-paste", "\r"],
      "capture": ["wezterm", "cli", "get-text", "--pane-id", "{target}"]
    },
    "kitty": {
      "priority": 70,
      "env_target": "KITTY_WINDOW_ID",
      "env_socket": "KITTY_LISTEN_ON",
      "require_env": ["KITTY_LISTEN_ON"],
      "send_text": ["kitty", "@", "--to", "{socket}", "send-text", "--match", "id:{target}", "--stdin"],
      "send_text_stdin": "{text}",
      "send_enter": ["kitty", "@", "--to", "{socket}", "send-text", "--match", "id:{target}", "--stdin"],
      "send_enter_stdin": "\r",
      "capture": ["kitty", "@", "--to", "{socket}", "get-text", "--match", "id:{target}"]
    }
  }
}
